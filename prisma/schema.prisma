generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                     Int                     @id @default(autoincrement())
  slug                   String                  @unique
  title                  String
  summary                String
  intro                  String
  description            String
  featuredImage          String
  githubUrl              String?
  deployUrl              String?
  videoUrl               String?
  images                 ProjectImage[]
  learningItems          ProjectLearningItem[]
  techUsageItems         ProjectTechUsageItem[]
  projectTechnicalSkills ProjectTechnicalSkill[]
}

model ProjectTechUsageItem {
  id        Int     @id @default(autoincrement())
  projectId Int
  techName  String
  usage     String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectLearningItem {
  id          Int     @id @default(autoincrement())
  projectId   Int
  title       String
  description String
  sortOrder   Int     @default(0)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  src       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TechStackGroup {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  slug   String           @unique
  skills TechnicalSkill[]
}

model TechnicalSkill {
  id       Int                     @id @default(autoincrement())
  name     String
  slug     String                  @unique
  groupId  Int
  projects ProjectTechnicalSkill[]
  group    TechStackGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProjectTechnicalSkill {
  id               Int            @id @default(autoincrement())
  projectId        Int
  technicalSkillId Int
  displayOrder     Int?
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technicalSkill   TechnicalSkill @relation(fields: [technicalSkillId], references: [id], onDelete: Cascade)

  @@unique([projectId, technicalSkillId])
}
