generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                     Int                       @id @default(autoincrement())
  slug                   String                    @unique
  title                  String
  summary                String
  intro                  String
  description            String
  featuredImage          String
  githubUrl              String?
  deployUrl              String?
  videoUrl               String?
  images                 ProjectImage[]
  projectTechnicalSkills ProjectTechnicalSkill[]
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int
  src       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TechnicalSkill {
  id          Int                       @id @default(autoincrement())
  name        String
  slug        String                    @unique
  group       String
  sortOrder   Int                       @default(0)
  projects    ProjectTechnicalSkill[]
}

model ProjectTechnicalSkill {
  id                 Int            @id @default(autoincrement())
  projectId        Int
  technicalSkillId Int
  displayOrder     Int?
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technicalSkill   TechnicalSkill @relation(fields: [technicalSkillId], references: [id], onDelete: Cascade)

  @@unique([projectId, technicalSkillId])
}